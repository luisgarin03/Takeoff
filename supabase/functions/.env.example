# SERVER ONLY. Set as Supabase Edge Function secrets; never use VITE_ prefixes.
OTK_DRIVE_CLIENT_ID=your-google-web-oauth-client-id
OTK_DRIVE_CLIENT_SECRET=your-google-web-oauth-client-secret
# Generate 32 cryptographically random bytes encoded as base64. Back this key up securely.
OTK_DRIVE_TOKEN_KEY=your-base64-32-byte-encryption-key
OTK_DRIVE_CALLBACK_URL=https://your-project.supabase.co/functions/v1/otk-drive?action=callback
# Exact origins only, no wildcard. https://localhost is the default Capacitor Android origin.
OTK_DRIVE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app,https://localhost
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by the hosted runtime.

# Cross-platform subscriptions. SERVER ONLY; never use VITE_ prefixes.
# RevenueCat secret keys are created per project and must stay in Edge Function secrets.
REVENUECAT_SECRET_API_KEY=sk_your_revenuecat_secret_key
REVENUECAT_ENTITLEMENT_ID=opentakeoff_pro
# Store product id -> app plan id. Keep this in sync with App Store Connect and RevenueCat.
REVENUECAT_PLAN_MAP={"com.opentakeoff.starter.monthly":"starter","com.opentakeoff.professional.monthly":"professional","com.opentakeoff.business.monthly":"business"}
# Prefer HMAC signing. Configure the same secret in RevenueCat Integrations > Webhooks.
REVENUECAT_WEBHOOK_SIGNING_SECRET=replace-with-a-long-random-secret
# Optional fallback if HMAC is not enabled. Include the complete header value, e.g. "Bearer ...".
REVENUECAT_WEBHOOK_AUTHORIZATION=
OTK_BILLING_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app,https://localhost,capacitor://localhost,opentakeoff://app
# Production should stay false. Enable only while testing store sandbox purchases.
OTK_ALLOW_SANDBOX_LICENSES=false

# Direct Drive sharing / Google Picker (same Google Cloud project as OAuth).
# Restrict this browser-visible API key to Picker/Drive APIs and app/docs.google.com referrers.
OTK_DRIVE_PICKER_KEY=your-restricted-picker-api-key
OTK_DRIVE_PICKER_APP_ID=your-google-cloud-project-number
OTK_SHARE_APP_URL=https://your-app.example.com/
