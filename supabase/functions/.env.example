# SERVER ONLY. Set as Supabase Edge Function secrets; never use VITE_ prefixes.
OTK_DRIVE_CLIENT_ID=your-google-web-oauth-client-id
OTK_DRIVE_CLIENT_SECRET=your-google-web-oauth-client-secret
# Generate 32 cryptographically random bytes encoded as base64. Back this key up securely.
OTK_DRIVE_TOKEN_KEY=your-base64-32-byte-encryption-key
OTK_DRIVE_CALLBACK_URL=https://your-project.supabase.co/functions/v1/otk-drive?action=callback
# Exact origins only, no wildcard. https://localhost is the default Capacitor Android origin.
OTK_DRIVE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-app.vercel.app,https://localhost
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by the hosted runtime.

# Direct Drive sharing / Google Picker (same Google Cloud project as OAuth).
# Restrict this browser-visible API key to Picker/Drive APIs and app/docs.google.com referrers.
OTK_DRIVE_PICKER_KEY=your-restricted-picker-api-key
OTK_DRIVE_PICKER_APP_ID=your-google-cloud-project-number
OTK_SHARE_APP_URL=https://your-app.example.com/
