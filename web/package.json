{
  "name": "opentakeoff-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "description": "OpenTakeoff — a free, open-source PDF takeoff canvas for flooring contractors.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/luisgarin03/Takeoff.git"
  },
  "scripts": {
    "preinstall": "node scripts/check-lockfile.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "dev": "vite",
    "build": "vite build",
    "start:desktop": "npm run build && electron .",
    "pack:win": "npm run build && electron-builder --config electron-builder.config.mjs --win nsis --x64 --dir",
    "dist:win": "npm run build && electron-builder --config electron-builder.config.mjs --win nsis --x64",
    "release:win": "npm run build && electron-builder --config electron-builder.config.mjs --win nsis --x64 --publish always",
    "ios:add": "npm run build && cap add ios --packagemanager SPM",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "lint": "eslint src netlify/functions"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/status-bar": "^8.0.3",
    "@radix-ui/react-dialog": "^1.1.23",
    "@revenuecat/purchases-capacitor": "^13.7.4",
    "@supabase/supabase-js": "^2.117.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "fflate": "^0.8.3",
    "openai": "^6.49.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.186.1",
    "tus-js-client": "^4.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.19.21",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.7.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "io.kentuckyai.opentakeoff.desktop",
    "copyright": "Copyright (c) 2026 Kentucky AI",
    "directories": {
      "output": "../release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "src/brand/appName.js",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
